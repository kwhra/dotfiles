# ============================================================================
# PATH Configuration
# ============================================================================
# This file configures the PATH environment variable

# ----------------------------------------------------------------------------
# User Binary Directories
# ----------------------------------------------------------------------------

# Add user's private bin directory to PATH if it exists
if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
fi

# Add user's local bin directory to PATH if it exists
if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------

# Volta - JavaScript Tool Manager
# https://volta.sh/
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# ----------------------------------------------------------------------------
# Optional: Python Environment (pyenv)
# ----------------------------------------------------------------------------
# Uncomment the following lines to enable pyenv
# export PYENV_ROOT="$HOME/.pyenv"
# export PATH="$PYENV_ROOT/bin:$PATH"
