# ============================================================================
# Zsh Aliases and Custom Functions
# ============================================================================

# ----------------------------------------------------------------------------
# Color Support for Common Commands
# ----------------------------------------------------------------------------

# Enable color support for ls, grep, and other commands
if [ -x /usr/bin/dircolors ]; then
    # Use custom dircolors if available, otherwise use default
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    
    # ls with colors and show hidden files
    alias ls='ls -a --color=auto'
    
    # grep family with color highlighting
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
    
    # diff with color highlighting
    alias diff='diff --color=auto'
fi

# ----------------------------------------------------------------------------
# Safe Delete: Trash Function
# ----------------------------------------------------------------------------
# Override rm command to move files to trash instead of permanent deletion
# This provides a safety net against accidental deletions

rm() {
    local TRASH_DIR=~/.trash
    local targets=()
    
    # Filter out flag arguments (those starting with -)
    # Only actual file/directory targets are moved to trash
    for arg in "$@"; do
        case "$arg" in
            -*)
                # Skip flag arguments
                ;;
            *)
                # Add file/directory targets
                targets+=("$arg")
                ;;
        esac
    done
    
    # If no targets specified, return early
    if [ ${#targets[@]} -eq 0 ]; then
        return
    fi
    
    # Move each target to trash
    for item in "${targets[@]}"; do
        local dest_path="$TRASH_DIR/$item"
        
        # If item with same name exists in trash, permanently delete it
        if [ -e "$dest_path" ]; then
            /bin/rm -rf "$dest_path"
        fi
        
        # Create parent directory structure in trash
        mkdir -p "$(dirname "$dest_path")"
        
        # Move item to trash
        mv "$item" "$dest_path"
    done
    
    # Periodically check trash size to prevent it from growing too large
    # Check randomly (1 in 20 chance) to avoid performance impact
    if [ $((RANDOM % 20)) -eq 0 ]; then
        local TRASH_SIZE_THRESHOLD_KB=1048576  # 1 GB
        local current_size_kb=$(du -sk "$TRASH_DIR" 2>/dev/null | cut -f1)
        
        # Warn if trash exceeds threshold
        if [ -n "$current_size_kb" ] && [ "$current_size_kb" -gt "$TRASH_SIZE_THRESHOLD_KB" ]; then
            echo
            echo "⚠️  Trash directory (~/.trash) size: $(($current_size_kb / 1024)) MB"
            echo "   Consider cleaning it up with: /bin/rm -rf $TRASH_DIR/*"
            echo
        fi
    fi
}

